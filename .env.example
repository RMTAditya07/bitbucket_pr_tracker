# Copy to .env and fill in. Never commit .env.

# --- Bitbucket Cloud -------------------------------------------------------
BITBUCKET_WORKSPACE=
BITBUCKET_REPOSITORY=

# Authentication — set exactly ONE of the three options below.
# (Bitbucket app passwords were retired in 2026 and are not supported.)
#
# Option A (recommended): Repository Access Token with "Pull requests: Read".
#   Repository settings → Security → Access tokens. Not tied to a person.
BITBUCKET_ACCESS_TOKEN=
#
# Option B: Atlassian API token (scoped) + your Atlassian account email.
#   Scopes: read:pullrequest:bitbucket, read:repository:bitbucket
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
#
# Option C: OAuth consumer (client-credentials grant). Workspace settings → OAuth consumers,
#   mark it "private", permission "Pull requests: Read". Acts as the consumer's owner.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# --- Zoho Sheet ------------------------------------------------------------
# Self Client from https://api-console.zoho.com (use the console for YOUR data centre).
# Scopes when generating the grant code: ZohoSheet.dataAPI.READ,ZohoSheet.dataAPI.UPDATE
#   (+ ZohoCliq.Webhooks.CREATE,ZohoCliq.Users.READ for the PR digest)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre: must match where your Zoho account lives.
#   US: accounts.zoho.com / sheet.zoho.com     India: accounts.zoho.in / sheet.zoho.in
#   EU: accounts.zoho.eu / sheet.zoho.eu        AU: accounts.zoho.com.au / sheet.zoho.com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_SHEET_API_URL=https://sheet.zoho.com

# Resource id = the long id in the spreadsheet URL: https://sheet.zoho.com/sheet/open/<THIS>
ZOHO_SHEET_ID=
ZOHO_WORKSHEET_NAME=PR Reviews
# Optional worksheets in the same spreadsheet (leave blank to disable):
ZOHO_MAPPING_WORKSHEET_NAME=PR Mapping
ZOHO_REVIEWER_LEVELS_WORKSHEET_NAME=Reviewer Levels
# Optional: Developer | L1 Reviewer 1 | L1 Reviewer 2 | From | To. PRs it covers use the rota's reviewers
ZOHO_REVIEW_ROTA_WORKSHEET_NAME=Review Rota
# Comma-separated tabs listing interactives (columns: Interactive Name, Interactive Type).
# The sync fills a PR's blank Interactive Name when its branch/title/description names exactly one of them.
ZOHO_INTERACTIVE_WORKSHEETS=Static Interactives,Dynamic Interactives
# Spacing between Zoho calls. Zoho locks the document for ~5 min if the per-minute limit is hit.
ZOHO_MIN_REQUEST_INTERVAL_MS=1000

# --- Jira (build tracker refresh: npm run sync:tracker) ------------
# Atlassian API token (id.atlassian.com → Security → API tokens) for an account that can browse
# the EIT project. Leave all three blank if you don't use the tracker refresh.
JIRA_BASE_URL=https://ei-study.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Custom field that holds story points on the phase tasks
JIRA_STORY_POINTS_FIELD=customfield_10028
# Tab holding Ticket + Build Drop date (d/m/yyyy); interactives dropping today or later are refreshed:
# their Status (from Jira phase tasks) and their rows in the completion tab.
TRACKER_BUILD_SOURCE_WORKSHEET=Static Interactives
TRACKER_COMPLETION_WORKSHEET=INTERACTIVE_COMPLETION

# --- PR digest to Zoho Cliq (npm run digest) --------------------------------
# Needs the Zoho token to also carry ZohoCliq.Webhooks.CREATE,ZohoCliq.Users.READ (see README).
# Unique name of the Cliq bot that sends the direct messages.
CLIQ_BOT_NAME=prreviewdigest
# Optional. Default: ZOHO_ACCOUNTS_URL with "accounts." -> "cliq." (e.g. https://cliq.zoho.in)
CLIQ_API_URL=
# People whose Cliq name differs from their Bitbucket name (logged as CLIQ_USER_NOT_FOUND):
#   CLIQ_USER_MAP=Stephen Prabhu=stephen@example.com; Other Person=other@example.com
CLIQ_USER_MAP=

# --- Sync ------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
# First run (or lost state file): look back this many days. 0 = entire PR history.
SYNC_INITIAL_LOOKBACK_DAYS=90
SYNC_STATE_FILE=.sync-state.json
# true  = every PR gets rows; Developer/Interactive/Phase left blank until you fill them in
#         (or add the PR to the mapping worksheet — blanks are then filled, never overwritten).
# false = PRs without a mapping are only logged as UNMAPPED_PR.
SYNC_INSERT_UNMAPPED_PRS=true
# Time zone used for Created At / Updated At / Last Synced At, e.g. Asia/Kolkata
SHEET_TIMEZONE=UTC

# --- Operational -----------------------------------------------------------
LOG_FORMAT=text
HTTP_TIMEOUT_MS=30000
HTTP_MAX_ATTEMPTS=4
